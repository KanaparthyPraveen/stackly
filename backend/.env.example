# ═══════════════════════════════════════════════════════
# Stackly Backend — Environment Configuration
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/stackly

# ── Session Management ───────────────────────────────
SESSION_SECRET=dev-session-secret-change-in-production
SESSION_COOKIE_NAME=stackly.sid
SESSION_MAX_AGE_MS=86400000
USE_MONGO_STORE=false

# ── GitHub OAuth Login ───────────────────────────────
# Create app at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3001/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
GITHUB_TOKEN=

# ── Google OAuth Login ───────────────────────────────
# Create app at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── Discord OAuth ─────────────────────────────────────
# Create app at: https://discord.com/developers/applications
# Callback: http://localhost:3001/api/v1/integrations/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Spotify OAuth ─────────────────────────────────────
# Create app at: https://developer.spotify.com/dashboard
# Callback: http://localhost:3001/api/v1/integrations/oauth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── WakaTime ──────────────────────────────────────────
WAKATIME_API_BASE_URL=https://wakatime.com/api/v1

# ── Cloudflare R2 Object Storage ──────────────────────
# Credentials for Cloudflare R2 S3-compatible bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stackly
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto

# ── Legacy S3 Object Storage (optional fallback) ──────
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=stackly-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=
